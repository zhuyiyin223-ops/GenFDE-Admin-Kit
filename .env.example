# 只存放密钥与凭据。非敏感配置请改 settings.py。
# 复制为本目录 .env 后填入真实值。

# 数据库连接（含账号密码）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/genfde_admin_kit

# NiceGUI 用户存储签名密钥
STORAGE_SECRET=change-me-in-production

# 对外 API JWT 签名密钥；不设则复用 STORAGE_SECRET
# JWT_SECRET=

# 启动时自动创建的默认管理员密码
DEFAULT_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# 部署：deploy.py 在服务器上读取
# ---------------------------------------------------------------------------
DEPLOY_GIT_REPO_URL=
DEPLOY_GIT_USERNAME=
DEPLOY_GIT_PASSWORD=
DEPLOY_SUPERVISOR_PROGRAM=
# DEPLOY_GIT_BRANCH=main
# DEPLOY_VENV_DIR=

# ---------------------------------------------------------------------------
# 远程部署：remote_deploy.py 在本地读取
# ---------------------------------------------------------------------------
DEPLOY_SSH_HOST=
DEPLOY_SSH_USERNAME=
DEPLOY_SSH_PRIVATE_KEY=
DEPLOY_REMOTE_PROJECT_PATH=
# DEPLOY_SSH_PORT=22
# DEPLOY_REMOTE_PYTHON=.venv/bin/python
# DEPLOY_SSH_CONNECT_TIMEOUT=15
